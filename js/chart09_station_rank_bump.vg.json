{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 920,
  "height": 330,
  "data": {
    "url": "data/c05_station_rank_history_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "survey": "number",
        "share": "number",
        "rank": "number",
        "latest_rank": "number",
        "rank_gain": "number"
      }
    }
  },
  "params": [
    {
      "name": "SelectedMarket",
      "value": "Melbourne"
    }
  ],
  "transform": [
    {
      "filter": "datum.market == SelectedMarket"
    },
    {
      "filter": "datum.latest_rank <= 5"
    },
    {
      "calculate": "'Survey ' + datum.survey",
      "as": "survey_name"
    },
    {
      "calculate": "'Biggest rise: ' + datum.station + ' (+' + datum.rank_gain + ' ranks)'",
      "as": "rise_note"
    }
  ],
  "encoding": {
    "x": {
      "field": "survey",
      "type": "ordinal",
      "title": "GfK 2026 survey",
      "sort": [
        3,
        4,
        5
      ],
      "axis": {
        "labelExpr": "'Survey ' + datum.label",
        "labelAngle": 0,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Station rank (1 = highest share)",
      "scale": {
        "domain": [
          7,
          1
        ]
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 110
        },
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "station",
          "type": "nominal",
          "title": "Station",
          "scale": {
            "range": [
              "#3D6A9A",
              "#E08058",
              "#6B9F79",
              "#8059A3",
              "#B14F66",
              "#7C828E"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3
          }
        },
        "tooltip": [
          {
            "field": "market",
            "type": "nominal",
            "title": "Market"
          },
          {
            "field": "station",
            "type": "nominal",
            "title": "Station"
          },
          {
            "field": "survey_name",
            "type": "nominal",
            "title": "Survey"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Share-based rank",
            "format": ".0f"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Total radio share (%)",
            "format": ".1f"
          },
          {
            "field": "rank_gain",
            "type": "quantitative",
            "title": "Rank change, S3 to S5",
            "format": "+.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.survey == 5 && datum.rank_gain > 0"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rise_order"
            }
          ],
          "sort": [
            {
              "field": "rank_gain",
              "order": "descending"
            },
            {
              "field": "station",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rise_order == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -12,
        "dy": -19,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#4A2A63"
      },
      "encoding": {
        "text": {
          "field": "rise_note",
          "type": "nominal"
        }
      }
    }
  ]
}
