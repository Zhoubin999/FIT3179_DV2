{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 470,
  "title": {
    "text": "How dominant is the leading station in each metro market?",
    "subtitle": "Five metro markets, GfK Survey 5 (2026); circle AREA ∝ share, colour reinforces small differences"
  },
  "data": {
    "url": "data/c12_market_leaders_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share_pct": "number",
        "latitude": "number",
        "longitude": "number"
      }
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27.5
    ],
    "scale": 590
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
        "format": {
          "type": "topojson",
          "feature": "collection"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F2F4",
        "stroke": "#CBD5DF",
        "strokeWidth": 0.48
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.93
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Leading share (%)",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              20
            ],
            "range": [
              0,
              4900
            ],
            "zero": true
          },
          "legend": {
            "orient": "right",
            "values": [
              5,
              10,
              15,
              20
            ],
            "symbolFillColor": "#E99B7D",
            "symbolStrokeColor": "#FFFFFF"
          }
        },
        "tooltip": [
          {
            "field": "market",
            "title": "Market"
          },
          {
            "field": "station",
            "title": "Top station"
          },
          {
            "field": "share_pct",
            "title": "Share (%)",
            "format": ".1f"
          }
        ],
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "linear",
            "domain": [
              12,
              18
            ],
            "range": [
              "#F3BFA6",
              "#B83E35"
            ]
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.market == SelectedMarket",
            "value": "#163F51"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.market == SelectedMarket",
            "value": 3.3
          },
          "value": 1.5
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.share_pct >= 15",
            "value": "#FFFFFF"
          },
          "value": "#24384B"
        },
        "tooltip": [
          {
            "field": "market",
            "title": "Market"
          },
          {
            "field": "station",
            "title": "Top station"
          },
          {
            "field": "share_pct",
            "title": "Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "dy": 42,
        "baseline": "top",
        "color": "#213C4F"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "market",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "SelectedMarket",
      "value": "Melbourne"
    }
  ],
  "transform": [
    {
      "calculate": "format(datum.share_pct, '.1f')+'%'",
      "as": "share_label"
    }
  ]
}
