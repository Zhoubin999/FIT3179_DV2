{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 470,
  "data": {
    "url": "data/c12_market_leaders_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share_pct": "number",
        "latitude": "number",
        "longitude": "number"
      }
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27.5
    ],
    "scale": 590
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
        "format": {
          "type": "topojson",
          "feature": "collection"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F2F4",
        "stroke": "#CBD5DF",
        "strokeWidth": 0.48
      }
    },
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.94
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Leading station share (%)",
          "scale": {
            "type": "linear",
            "domain": [
              12,
              18
            ],
            "range": [
              750,
              8200
            ],
            "zero": false
          },
          "legend": {
            "orient": "right",
            "title": "Leader share (12–18%)",
            "values": [
              12,
              14,
              16,
              18
            ],
            "format": ".0f",
            "symbolFillColor": "#DF8C79",
            "symbolStrokeColor": "#FFFFFF"
          }
        },
        "color": {
          "field": "share_pct",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "domain": [
              12,
              18
            ],
            "range": [
              "#F6BDA8",
              "#B94F43"
            ]
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.market == SelectedMarket",
            "value": "#153B4D"
          },
          "value": "#FFFFFF"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.market == SelectedMarket",
            "value": 3.1
          },
          "value": 1.6
        },
        "tooltip": [
          {
            "field": "market",
            "type": "nominal",
            "title": "Market"
          },
          {
            "field": "station",
            "type": "nominal",
            "title": "Leading station"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Radio share (%)",
            "format": ".1f"
          },
          {
            "field": "survey",
            "type": "nominal",
            "title": "Source survey"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.market == 'Perth'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 0,
        "dy": 68,
        "align": "center",
        "baseline": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#1F3545"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.market == 'Adelaide'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": -18,
        "dy": 62,
        "align": "center",
        "baseline": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#1F3545"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.market == 'Melbourne'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 28,
        "dy": 66,
        "align": "center",
        "baseline": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#1F3545"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.market == 'Sydney'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 34,
        "dy": -55,
        "align": "center",
        "baseline": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#1F3545"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.market == 'Brisbane'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 38,
        "dy": -40,
        "align": "center",
        "baseline": "middle",
        "fontSize": 15,
        "fontWeight": "bold",
        "color": "#1F3545"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "SelectedMarket",
      "value": "Melbourne"
    }
  ],
  "transform": [
    {
      "calculate": "datum.market + '  ' + format(datum.share_pct, '.1f') + '%'",
      "as": "label"
    }
  ]
}
