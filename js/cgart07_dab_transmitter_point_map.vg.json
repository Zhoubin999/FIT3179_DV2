{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 520,

  "title": {
    "text": "Where Are Licensed DAB+ Transmitter Sites Located in Australia?",
    "subtitle": [
      "ACMA July 2026: 29 mapped coordinates from 63 digital-radio licence records",
      "Each point shows a site location, not its signal coverage"
    ]
  },

  "projection": {"type": "mercator"},

  "params": [
    {
      "name": "State_selection",
      "value": "All states",
      "bind": {
        "input": "select",
        "options": ["All states", "NSW", "VIC", "QLD", "SA", "WA", "TAS", "ACT", "NT"],
        "name": "State: "
      }
    }
  ],

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.min.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1F5F9",
        "stroke": "#94A3B8",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "data/acma_dab_transmitters_july2026.csv",
        "format": {
          "type": "csv",
          "parse": {"latitude": "number", "longitude": "number"}
        }
      },

      "transform": [
        {"filter": "isValid(datum.latitude) && isValid(datum.longitude)"},
        {
          "filter": "State_selection == 'All states' || datum.state == State_selection"
        },
        {
          "aggregate": [
            {"op": "count", "as": "licence_records"}
          ],
          "groupby": ["latitude", "longitude", "state", "area_served", "site_name"]
        }
      ],

      "mark": {
        "type": "circle",
        "filled": true,
        "size": 95,
        "color": "#6D28D9",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.1
      },

      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "tooltip": [
          {"field": "area_served", "type": "nominal", "title": "Area served"},
          {"field": "state", "type": "nominal", "title": "State / territory"},
          {"field": "site_name", "type": "nominal", "title": "Licensed site"},
          {
            "field": "licence_records",
            "type": "quantitative",
            "title": "Licence entries at this site",
            "format": ".0f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {"stroke": null}
  }
}
