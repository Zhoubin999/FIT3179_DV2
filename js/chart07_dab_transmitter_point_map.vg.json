{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 520,

  "title": {
    "text": "Where Are Licensed DAB+ Transmitter Sites Located in Australia?",
    "subtitle": [
      "ACMA July 2026: 29 mapped coordinates from 63 digital-radio licence records",
      "Each dot represents a site location, not its broadcast coverage"
    ]
  },

  "projection": {
    "type": "mercator",
    "center": [134, -27.5],
    "scale": 650
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
        "format": {"type": "topojson", "feature": "collection"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF2F7",
        "stroke": "#94A3B8",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "data/acma_dab_transmitters_july2026.csv",
        "format": {
          "type": "csv",
          "parse": {"latitude": "number", "longitude": "number"}
        }
      },

      "transform": [
        {"filter": "isValid(datum.latitude) && isValid(datum.longitude)"},
        {
          "aggregate": [{"op": "count", "as": "licence_records"}],
          "groupby": ["latitude", "longitude", "state", "area_served", "site_name"]
        }
      ],

      "mark": {
        "type": "circle",
        "filled": true,
        "size": 110,
        "color": "#6D28D9",
        "opacity": 0.85,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.1
      },

      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "tooltip": [
          {"field": "area_served", "type": "nominal", "title": "Area served"},
          {"field": "state", "type": "nominal", "title": "State / territory"},
          {"field": "site_name", "type": "nominal", "title": "Licensed site"},
          {
            "field": "licence_records",
            "type": "quantitative",
            "title": "Licence entries at site",
            "format": ".0f"
          }
        ]
      }
    }
  ],

  "config": {
    "view": {"stroke": null}
  }
}
