{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 460,
  "data": {
    "url": "data/c10_dab_service_city_locations.csv",
    "format": {
      "type": "csv",
      "parse": {
        "latitude": "number",
        "longitude": "number",
        "licence_entries_in_named_area": "number"
      }
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27.5
    ],
    "scale": 570
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/cartdeco/Australia-json-data/master/aus25fgd_r.topojson",
        "format": {
          "type": "topojson",
          "feature": "collection"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F0F2F4",
        "stroke": "#CBD5DF",
        "strokeWidth": 0.48
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 180,
        "fill": "#7753AC",
        "opacity": 0.9,
        "stroke": "#fff",
        "strokeWidth": 1.6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "city",
            "title": "Licensed area"
          },
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "frequency_blocks_in_named_area",
            "title": "Frequency blocks at listed area"
          },
          {
            "field": "licence_entries_in_named_area",
            "type": "quantitative",
            "title": "Licence entries in this named area",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#243F52",
        "dy": -14,
        "baseline": "bottom"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "city",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
