{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 760,
  "height": 330,

  "title": {
    "text": "How Does Audio Listening Differ Between Metro and Regional Australia?",
    "subtitle": "Share of Australian adults aged 18+ reporting use in the previous 7 days, 2025 (ACMA)"
  },

  "data": {
    "url": "data/acma_listening_2026.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number", "value": "number"}
    }
  },

  "transform": [
    {"filter": "datum.year == 2025"},
    {"filter": "datum.subgroup_type == 'Area'"},
    {
      "filter": "(datum.dataset_section == 'Listening behaviours (previous 7 days)' && (datum.metric == 'Used music streaming service' || datum.metric == 'Listened to podcasts')) || (datum.dataset_section == 'Audio types (previous 7 days)' && (datum.metric == 'FM radio' || datum.metric == 'DAB+ radio' || datum.metric == 'Radio via internet/app'))"
    },
    {
      "calculate": "datum.metric == 'Used music streaming service' ? 'Music streaming' : datum.metric == 'Listened to podcasts' ? 'Podcasts' : datum.metric == 'Radio via internet/app' ? 'Internet/app radio' : datum.metric",
      "as": "audio_type"
    },
    {"calculate": "datum.value + '%'", "as": "value_label"}
  ],

  "encoding": {
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Used in the previous 7 days (%)",
      "scale": {"domain": [0, 85]},
      "axis": {"tickCount": 6}
    },
    "y": {
      "field": "audio_type",
      "type": "nominal",
      "title": null,
      "sort": ["FM radio", "DAB+ radio", "Internet/app radio", "Music streaming", "Podcasts"],
      "axis": {"labelFontSize": 12, "labelPadding": 12}
    }
  },

  "layer": [
    {
      "transform": [
        {
          "pivot": "subgroup",
          "value": "value",
          "groupby": ["audio_type"]
        },
        {
          "calculate": "datum.Metropolitan - datum.Regional",
          "as": "metro_minus_regional"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#94A3B8",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {"field": "Metropolitan", "type": "quantitative"},
        "x2": {"field": "Regional"},
        "tooltip": [
          {"field": "audio_type", "type": "nominal", "title": "Audio type"},
          {"field": "Metropolitan", "type": "quantitative", "title": "Metropolitan (%)"},
          {"field": "Regional", "type": "quantitative", "title": "Regional (%)"},
          {
            "field": "metro_minus_regional",
            "type": "quantitative",
            "title": "Metro minus regional (pp)",
            "format": "+.0f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "subgroup",
          "type": "nominal",
          "title": "Area",
          "scale": {
            "domain": ["Metropolitan", "Regional"],
            "range": ["#2563EB", "#0F766E"]
          },
          "legend": {"orient": "bottom", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "audio_type", "type": "nominal", "title": "Audio type"},
          {"field": "subgroup", "type": "nominal", "title": "Area"},
          {"field": "value", "type": "quantitative", "title": "Weekly use (%)", "format": ".0f"}
        ]
      }
    },

    {
      "transform": [
        {"filter": "datum.subgroup == 'Metropolitan'"}
      ],
      "mark": {
        "type": "text",
        "dy": -17,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1D4ED8"
      },
      "encoding": {
        "text": {"field": "value_label", "type": "nominal"}
      }
    },

    {
      "transform": [
        {"filter": "datum.subgroup == 'Regional'"}
      ],
      "mark": {
        "type": "text",
        "dy": 17,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#0F766E"
      },
      "encoding": {
        "text": {"field": "value_label", "type": "nominal"}
      }
    },

    {
      "transform": [
        {"filter": "datum.audio_type == 'DAB+ radio' && datum.subgroup == 'Metropolitan'"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "dy": 21,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#1E3A8A"
      },
      "encoding": {
        "text": {"value": "Metro is 10 percentage points higher"}
      }
    }
  ]
}
